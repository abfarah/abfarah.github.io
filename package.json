{
  "name": "abfarah.github.io",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint-check-only": "npx eslint .",
    "lint-fix": "npx eslint . --fix",
    "prettier": "npx prettier --write .",
    "prepare": "husky install"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write",
      "eslint"
    ]
  },
  "dependencies": {
    "lint-staged": "^16.2.7",
    "next": "16.1.0",
    "prettier": "^3.7.4",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@next/eslint-plugin-next": "^16.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.0",
    "eslint-plugin-perfectionist": "^5.0.0",
    "husky": "^9.1.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.50.0"
  }
}
